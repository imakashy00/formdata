# Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Application Environment
# Options: development, staging, production
ENV=development

# Base URL (optional, auto-detected if not set)
# Example: https://yourdomain.com
BASE_URL=

# Server Port (for local development)
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/dbname
DATABASE_PORT=5432
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# PostgreSQL (for Docker Compose)
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_ALGO=HS256
JWT_SECRET=your-super-secret-jwt-key-here-change-this
ACCESS_TTL_MIN=15
REFRESH_TTL_MIN=45

# Application Secret (for session middleware)
SECRET=your-super-secret-app-key-here-change-this

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Smart Proxy (if using)
SMART_PROXY_USERNAME=your-proxy-username
SMART_PROXY_PASSWORD=your-proxy-password

# Paddle Payment Integration
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
PADDLE_BASE_URL=https://sandbox-api.paddle.com
PADDLE_MONTHLY_PRICE_ID=your-monthly-price-id
PADDLE_YEARLY_PRICE_ID=your-yearly-price-id


# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# Notes:
# - Generate secure random strings for JWT_SECRET and SECRET using: openssl rand -hex 32
# - For production, use strong passwords and keep this file secure
# - Update PADDLE_BASE_URL to production URL when going live
